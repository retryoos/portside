# Backend base URL. Defaults to http://localhost:8000 if unset. Baked at build
# time by Next.js, so a deploy must rebuild after this changes.
# On Vercel (Tier 0 demo) or AWS Amplify (later), set this to the App Runner URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only override: lets a deploy point route handlers at an internal
# backend address while the browser still uses NEXT_PUBLIC_API_URL. Optional.
API_INTERNAL_URL=

# Signs the session JWT verified by the Edge middleware gate, /api/auth/me,
# and /api/auth/token. MUST match the API's APP_JWT_SECRET on both sides. Dev
# falls back to an insecure default when unset; production deploys must set a
# real value. Generate one with: openssl rand -hex 32
APP_JWT_SECRET=

# Canonical site URL used for metadata, robots.txt, and sitemap.xml. Defaults
# to https://laytimely.com if unset.
NEXT_PUBLIC_SITE_URL=

# Web3Forms access key for the marketing contact form. Public by design (it only
# authorizes delivery to the registered address). Without it the contact form
# shows an "email us directly" fallback instead of submitting. Get one at
# https://web3forms.com.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Multi-tenant workspaces UI flag. Must match the API's WORKSPACES_UI to keep
# the frontend and backend behavior consistent. Off by default.
NEXT_PUBLIC_WORKSPACES_UI=
