# Backend base URL. Defaults to http://localhost:8000 if unset. Baked at build
# time by Next.js, so a deploy must rebuild after this changes.
# On Vercel (Tier 0 demo) or AWS Amplify (later), set this to the App Runner URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# HMAC secret for the auth-stub session cookie (notes/21-authentication-stub.md).
# Local dev falls back to a hardcoded string when unset; production deploys must
# set a real value. Generate one with: openssl rand -hex 32
AUTH_SECRET=local-dev-secret-please-do-not-deploy-this

# Web3Forms access key for the marketing contact form. Public by design (it only
# authorizes delivery to the registered address). Without it the contact form
# shows an "email us directly" fallback instead of submitting. Get one at
# https://web3forms.com.
NEXT_PUBLIC_WEB3FORMS_KEY=
