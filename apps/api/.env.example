# Template — copy to apps/api/.env (gitignored) and fill in the real key.
# Production deploys pass these as real env vars (Docker ENV, App Runner, etc.).
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_PRIMARY=claude-sonnet-4-6
ANTHROPIC_MODEL_ESCAPE=claude-opus-4-7
REQUEST_TIMEOUT_S=30
CORS_ORIGINS=http://localhost:3000
# Persistence. Local dev defaults to a SQLite file next to the package if unset.
#  - Neon (demo): postgresql+asyncpg://USER:PASS@HOST/neondb?ssl=require
#    (use the +asyncpg scheme and ?ssl=require; drop Neon's sslmode/channel_binding)
#  - Aurora (prod): postgresql+asyncpg://USER:PASS@HOST:5432/DBNAME
DATABASE_URL=sqlite+aiosqlite:///./portside.db

# Auth (A2). DEV_AUTH=1 bypasses JWT verification and uses a fixed dev user —
# leave it on locally until Cognito is provisioned. In production set DEV_AUTH=0
# and fill the COGNITO_* values (Panos / notes/19). With no DEV_AUTH set, auth is
# enabled automatically once COGNITO_USER_POOL_ID is present.
DEV_AUTH=1
COGNITO_REGION=eu-west-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Object storage for uploaded PDFs (A3). With no S3_BUCKET, PDFs are written to
# a local directory (OBJECTS_DIR). Set S3_BUCKET to use object storage.
#  - Cloudflare R2 (demo): S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com,
#    S3_REGION=auto, and the R2 token keys as AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
#  - AWS S3 (prod): leave S3_ENDPOINT_URL unset; use the bucket region + IAM role.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_PREFIX=
# boto3 reads these automatically (R2 token keys for the demo):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# OBJECTS_DIR=./_objects

# Interactive API docs (/docs, /redoc, /openapi.json). Off by default; leave it
# on locally for convenience and keep it UNSET in production so the open surface
# is not self-documenting.
EXPOSE_DOCS=1
