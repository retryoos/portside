# Template — copy to apps/api/.env (gitignored) and fill in the real key.
# Production deploys pass these as real env vars (Docker ENV, App Runner, etc.).
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_PRIMARY=claude-sonnet-4-6
ANTHROPIC_MODEL_ESCAPE=claude-opus-4-7
REQUEST_TIMEOUT_S=30
CORS_ORIGINS=http://localhost:3000
# Persistence. Local dev defaults to a SQLite file next to the package if unset.
#  - Neon (demo): postgresql+asyncpg://USER:PASS@HOST/neondb?ssl=require
#    (use the +asyncpg scheme and ?ssl=require; drop Neon's sslmode/channel_binding)
#  - Aurora (prod): postgresql+asyncpg://USER:PASS@HOST:5432/DBNAME
DATABASE_URL=sqlite+aiosqlite:///./portside.db

# Auth (A2). DEV_AUTH=1 bypasses JWT verification and uses a fixed dev user —
# leave it on locally until Cognito is provisioned. In production set DEV_AUTH=0
# and fill the COGNITO_* values (Panos / notes/19). With no DEV_AUTH set, auth is
# enabled automatically once COGNITO_USER_POOL_ID is present.
DEV_AUTH=1
COGNITO_REGION=eu-west-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Object storage for uploaded PDFs (A3). With no S3_BUCKET, PDFs are written to
# a local directory (OBJECTS_DIR). Set S3_BUCKET to use object storage.
#  - Cloudflare R2 (demo): S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com,
#    S3_REGION=auto, and the R2 token keys as AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
#  - AWS S3 (prod): leave S3_ENDPOINT_URL unset; use the bucket region + IAM role.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_PREFIX=
# boto3 reads these automatically (R2 token keys for the demo):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# OBJECTS_DIR=./_objects

# Interactive API docs (/docs, /redoc, /openapi.json). Off by default; leave it
# on locally for convenience and keep it UNSET in production so the open surface
# is not self-documenting.
EXPOSE_DOCS=1

# First-party email/password auth. Signs the HS256 session JWT minted by
# /auth/signup and /auth/login. Dev falls back to an insecure default (must
# match apps/web's APP_JWT_SECRET) so localhost works with zero config;
# production MUST set a long random value: openssl rand -hex 32.
APP_JWT_SECRET=
APP_JWT_TTL_SECONDS=604800

# Admin dashboard allowlist (cost/usage observability). Comma-separated
# emails allowed to reach /admin routes. Empty means no one is an admin.
ADMIN_EMAILS=

# Comma-separated emails that get their own private, pre-seeded demo account
# on signup/login (e.g. for handing out a populated demo login).
DEMO_SHARE_EMAILS=

# DB connection pool size. 0 (default) uses a fresh connection per request
# (NullPool) — simplest, multi-loop safe. Set >0 on a long-running server to
# reuse warm connections.
DB_POOL_SIZE=0

# Signup is invite-only by default. Setting this lets a founder self-serve
# the first account without an invitation (bootstraps the first owner).
# Leave unset to disable the bootstrap path entirely.
SIGNUP_BOOTSTRAP_CODE=

# Per-account and global quotas on the expensive (Anthropic-calling) pipeline
# trigger. Counted from the audit log so limits survive restarts.
PER_ACCOUNT_PIPELINE_MAX=5
PER_ACCOUNT_PIPELINE_WINDOW_SECONDS=3600
DEMO_PIPELINE_MAX=3
GLOBAL_PIPELINE_DAILY_MAX=0

# Coarse rate limit on POST /voyages (abuse/cost guard, not an auth boundary).
# Set RATE_LIMIT_MAX_REQUESTS=0 to disable.
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# How long (seconds) a voyage can sit in a non-terminal pipeline stage with no
# progress before it's reaped to "error" on startup (its driving task died).
STALE_RUN_SECONDS=900

# Research/legal-citation live-mode toggles. Off by default: research tools
# serve a committed offline fixture, and the legal corpus is IMO conventions
# only. Flip to 1/true to enable the live EUR-Lex CELLAR client / BAILII
# scraper / a live weather-calendar feed respectively.
RESEARCH_LIVE=0
LEGAL_EUR_LEX_LIVE=0
LEGAL_BAILII_LIVE=0

# Email send via SES. Off by default so dev environments without an SES
# identity exercise the sandbox path (audit row + rate limit, no outbound).
EMAIL_SEND_LIVE=0
SES_SENDER=

# Email-in ingestion (SES -> S3 -> Lambda). Shared secret the forwarded
# payload is signed with; unset means the inbound route refuses every call
# (fail-closed). Generate with: openssl rand -hex 32.
EMAIL_IN_SHARED_SECRET=
# Per-workspace inbound addresses look like <workspace-slug>@<inbox_domain>.
INBOX_DOMAIN=in.laytimely.com

# Workspace invitations: base URL for accept links, and a per-actor rate
# limit on minting invitations.
INVITATION_BASE_URL=http://localhost:3000
INVITATION_RATE_LIMIT_MAX=20
INVITATION_RATE_LIMIT_WINDOW_SECONDS=3600

# Days to retain audit log rows before they're reaped on startup. 0 disables
# retention (forever-grow).
AUDIT_RETENTION_DAYS=90

# Multi-tenant workspaces UI flag. The backend always mints a personal
# workspace per user; this only controls whether the frontend shows the
# workspace switcher. Flip on per-account when a team needs it.
WORKSPACES_UI=0
